# ==============================================================================
# Alumni Tracking System - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and adjust values for your local or deployment setup:
#   cp .env.example .env
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5001
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 🗄️ Database Credentials (PostgreSQL 15)
# ------------------------------------------------------------------------------
# Use 'db' when running backend inside Docker Compose.
# Use 'localhost' when running Node directly on the host machine.
DB_HOST=db
DB_PORT=5432
DB_USER=alumni_user
DB_PASSWORD=alumni_password
DB_NAME=alumni_db

# Full connection string for ORMs / query builders (Knex, Prisma, pg-pool)
DATABASE_URL=postgresql://alumni_user:alumni_password@db:5432/alumni_db

# ------------------------------------------------------------------------------
# 🔐 Security & Authentication (JWT)
# ------------------------------------------------------------------------------
# Replace with a cryptographically secure secret string in production
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 📖 Swagger / OpenAPI Documentation
# ------------------------------------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_ROUTE=/api/swagger
